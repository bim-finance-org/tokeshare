# One .env per SDP stack (= per Stellar network). Generate the secrets with:
#   npm run sdp:secrets -- testnet     (or mainnet)
# Never commit the filled-in file. Keep a copy in the team vault.

NETWORK_TYPE=testnet
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org
STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
# mainnet:
# NETWORK_TYPE=pubnet
# NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# HORIZON_URL=https://horizon.stellar.org
# RPC_URL=https://mainnet.sorobanrpc.com
# STELLAR_EXPERT_URL=https://stellar.expert/explorer/public

# Public URLs (Coolify domains): sdp-api → port 8000, sdp-frontend → port 80
SDP_API_URL=https://sdp-api-testnet.tokeshare.co
SDP_UI_URL=https://sdp-testnet.tokeshare.co

# Turn MFA on for mainnet (it then needs an email provider to send codes)
SDP_DISABLE_MFA=true

SDP_DB_PASSWORD=

# Dedicated distribution account — NOT the distributor admin / operator account
DISTRIBUTION_PUBLIC_KEY=
DISTRIBUTION_SEED=
# Both must be Stellar secret seeds (S...), not free-form passwords
DISTRIBUTION_ACCOUNT_ENCRYPTION_PASSPHRASE=
CHANNEL_ACCOUNT_ENCRYPTION_PASSPHRASE=
# SEP-10 signing keypair (unfunded is fine)
SEP10_SIGNING_PUBLIC_KEY=
SEP10_SIGNING_PRIVATE_KEY=
EC256_PRIVATE_KEY=
SEP24_JWT_SECRET=
ADMIN_ACCOUNT=tokeshare-admin
ADMIN_API_KEY=

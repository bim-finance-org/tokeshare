NEXT_PUBLIC_PROJECT_ID = "your-project-id"
COINGECKO_API_KEY = "your-api-key"
COINMARKETCAP_API_KEY = "your-api-key"
DATABASE_URL= "your-database-url"
DATABASE_URL_UNPOOLED= "your-database-url"
NEXTAUTH_SECRET= "your-secret-key"
NEXTAUTH_URL= "your-url"
DASHBOARD_PASSWORD= "your-password"
REDIS_URL= "your-redis-url"
EXCHANGE_RATE_API_KEY= "your-api-key"
RESEND_API_KEY= "your-api-key"
RESEND_FROM_EMAIL="your-email"
NEXT_PUBLIC_TOKESHARE_TGG_RECIPIENT="your-address"
NEXT_PUBLIC_TOKESHARE_TSG_RECIPIENT="your-address"
NEXT_PUBLIC_TOKESHARE_TFT_RECIPIENT="your-address"
TOKESHARE_USDC_SENDER_PRIVATE_KEY="your-private-key"
# Privy (email/social onboarding for Stellar). Leave empty to disable the Privy
# path entirely (only Stellar Wallets Kit is used).
NEXT_PUBLIC_PRIVY_APP_ID=""
# Stellar revenue distributor (tranche 2) — one contract per network, empty
# until deployed.
NEXT_PUBLIC_STELLAR_MAINNET_DISTRIBUTOR_ID=""
NEXT_PUBLIC_STELLAR_TESTNET_DISTRIBUTOR_ID=""

# Stellar indexer worker (npm run indexer — separate Coolify app).
# Poll cadence; the RPC only retains ~24h of events, so keep well under that.
STELLAR_INDEXER_POLL_MINUTES="30"
# /health returns 503 past this lag, so Coolify restarts the worker.
STELLAR_INDEXER_MAX_LAG_MINUTES="120"
# Optional: first-boot start ledger (defaults to ~30min back from latest).
STELLAR_INDEXER_START_LEDGER=""

# Distributor admin (server-side signing for the dashboard console). The
# account that funds cycles: needs XLM for fees + the month's USDC.
STELLAR_DISTRIBUTOR_ADMIN_SECRET=""
# Extra addresses to exclude from snapshots (comma-separated), e.g. treasury.
STELLAR_SNAPSHOT_EXCLUDE=""
# Initial distribute_for batch size (batches self-split on resource limits).
STELLAR_DISTRIBUTE_BATCH_SIZE="10"

# Fee sponsor for holder claims: wraps holder-signed claim/trustline txs in a
# fee-bump so Privy investors with zero XLM can collect. Leave empty to make
# holders pay their own fees.
STELLAR_FEE_SPONSOR_SECRET=""

# SEP-24 ramp anchors (cash-in/cash-out). The protocol is standard, so the
# home domain decides the provider: SDF test anchor by default on testnet,
# MoneyGram once partner keys are provisioned (extstellar.moneygram.com on
# testnet, stellar.moneygram.com in production).
NEXT_PUBLIC_STELLAR_RAMP_NETWORK="testnet"
NEXT_PUBLIC_STELLAR_TESTNET_RAMP_HOME_DOMAIN="testanchor.stellar.org"
NEXT_PUBLIC_STELLAR_MAINNET_RAMP_HOME_DOMAIN="stellar.moneygram.com"

# MoneyGram wallet whitelist keypairs. The PUBLIC keys go in the Partner Portal
# whitelist form; the secrets stay server-side. The auth key co-signs SEP-10
# challenges (client_domain) and its public key is served on
# /.well-known/stellar.toml; deposit/withdraw are the whitelisted funds
# accounts. Empty = plain SEP-10 (the SDF test anchor needs none of this).
STELLAR_RAMP_AUTH_SECRET=""
STELLAR_RAMP_DEPOSIT_SECRET=""
STELLAR_RAMP_WITHDRAW_SECRET=""
# Domain serving our stellar.toml, as declared in the whitelist form.
NEXT_PUBLIC_STELLAR_RAMP_CLIENT_DOMAIN=""

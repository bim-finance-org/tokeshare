# ---- Stellar deployment config for scripts/stellar/deploy.sh ----
# Copy to .env (gitignored) and fill in. NEVER commit real secret keys.
#
# ⚠️  Defaults below target MAINNET (real funds). Switch to testnet values
#     while developing if you change your mind.

# Network. Mainnet (Public) values:
NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# Use your own Soroban RPC provider in production. Public endpoint example:
RPC_URL="https://mainnet.sorobanrpc.com"
# Testnet alternative:
#   NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
#   RPC_URL="https://soroban-testnet.stellar.org"

# The TRES asset. Code is up to 12 chars.
ASSET_CODE="TRES"

# Payment asset buyers pay with.
#   "native"        -> XLM (no treasury trustline needed)
#   "CODE:ISSUER"   -> a classic asset such as USDC
# Circle USDC on Stellar MAINNET:
PAY_ASSET="USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN"

# --- Accounts (all must be funded with XLM for fees/reserves) ---
# Issuer: mints TRES. Distributor: holds supply + funds the sale contract.
# Treasury: receives the payment (needs a trustline to PAY_ASSET unless native).
# Admin: owns/updates the sale contract. You may reuse one account for several
# roles, but separate is cleaner. Secrets can be a raw S... key OR a stellar-cli
# identity name (e.g. "tres-operator").
ISSUER_PUBLIC="G..."
ISSUER_SECRET="S..."
DISTRIBUTOR_PUBLIC="G..."
DISTRIBUTOR_SECRET="S..."
TREASURY_PUBLIC="G..."
TREASURY_SECRET="S..."        # required when PAY_ASSET is not "native"
ADMIN_PUBLIC="G..."
ADMIN_SECRET="S..."

# --- Amounts ---
# Whole-token / whole-payment values (decimals up to 7 dp allowed).
TOTAL_SUPPLY="23000"        # total TRES to issue
SALE_INVENTORY="23000"      # TRES moved into the sale contract for sale
PRICE_PER_TRES="10"         # fixed price: how many units of PAY_ASSET buy 1 TRES

# Optional: path to the built contract wasm (defaults to the soroban build dir)
# WASM_PATH="/abs/path/to/tres_sale.wasm"
